<script>
function komut(k){
  fetch('/komut?k='+k)
    .then(r=>r.text())
    .then(t=>document.getElementById('durum').textContent=t)
    .catch(e=>document.getElementById('durum').textContent='hata: '+e);
}
function hizGuncelle(){
  const a=document.getElementById('aracHiz').value;
  const k=document.getElementById('kolHiz').value;
  document.getElementById('aracHizGoster').textContent=a;
  document.getElementById('kolHizGoster').textContent=k;
  fetch(`/hiz?arac=${a}&kol=${k}`);
}

// --- Bas-çek butonları (çoklu dokunma destekli) ---
// pointerId -> { btn, birakKomut }
const aktifPointerlar = new Map();

document.querySelectorAll('[data-bas]').forEach(btn => {
  btn.addEventListener('pointerdown', (e) => {
    e.preventDefault();
    if (aktifPointerlar.has(e.pointerId)) return;
    // Pointer capture'ı serbest bırak ki parmak kayarsa diğer butonlar da algılansın
    if (btn.releasePointerCapture) {
      try { btn.releasePointerCapture(e.pointerId); } catch(_) {}
    }
    aktifPointerlar.set(e.pointerId, { btn, birakKomut: btn.dataset.birak });
    btn.classList.add('basili');
    if (navigator.vibrate) navigator.vibrate(15);
    komut(btn.dataset.bas);
  });
});

const pointerBirak = (e) => {
  const aktif = aktifPointerlar.get(e.pointerId);
  if (!aktif) return;
  aktif.btn.classList.remove('basili');
  komut(aktif.birakKomut);
  aktifPointerlar.delete(e.pointerId);
};

// Document seviyesinde dinle — parmak butondan kaysa bile dur komutu kesin gider
document.addEventListener('pointerup', pointerBirak);
document.addEventListener('pointercancel', pointerBirak);

// Acil DUR butonu (tek tıklama, aynı zamanda her şeyi sıfırlar)
document.getElementById('durBtn').addEventListener('pointerdown', (e) => {
  e.preventDefault();
  const b = e.currentTarget;
  b.classList.add('basili');
  if (navigator.vibrate) navigator.vibrate(40);
  komut('dur'); komut('alt_dur'); komut('ust_dur');
  // Aktif tüm pointer'ları temizle
  aktifPointerlar.forEach(a => a.btn.classList.remove('basili'));
  aktifPointerlar.clear();
  setTimeout(() => b.classList.remove('basili'), 180);
});

// Sayfa arka plana düşerse (telefon kilidi vb.) her şeyi durdur
document.addEventListener('visibilitychange', () => {
  if (document.hidden) {
    komut('dur'); komut('alt_dur'); komut('ust_dur');
    aktifPointerlar.forEach(a => a.btn.classList.remove('basili'));
    aktifPointerlar.clear();
  }
});

// Metin seçimini ve sağ-tık menüsünü engelle
document.addEventListener('selectstart', e => e.preventDefault());
document.addEventListener('contextmenu', e => e.preventDefault());
document.addEventListener('dragstart', e => e.preventDefault());
</script>
