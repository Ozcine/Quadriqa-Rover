// ============= HTTP HANDLER'LARI =============
void handleRoot() {
  sunucu.send_P(200, "text/html", SAYFA);
}

void handleKomut() {
  if (!sunucu.hasArg("k")) { sunucu.send(400, "text/plain", "komut yok"); return; }
  String k = sunucu.arg("k");

  if      (k == "ileri")      aracIleri();
  else if (k == "geri")       aracGeri();
  else if (k == "sol")        aracSol();
  else if (k == "sag")        aracSag();
  else if (k == "dur")        aracDur();
  else if (k == "alt_yukari") altEksenYukari(kolHizi);
  else if (k == "alt_asagi")  altEksenAsagi(kolHizi);
  else if (k == "alt_dur")    altEksenDur();
  else if (k == "ust_yukari") ustEksenYukari(kolHizi);
  else if (k == "ust_asagi")  ustEksenAsagi(kolHizi);
  else if (k == "ust_dur")    ustEksenDur();
  else { sunucu.send(400, "text/plain", "bilinmeyen komut"); return; }

  Serial.print("[Komut] ");
  Serial.println(k);
  sunucu.send(200, "text/plain", "ok:" + k);
}

void handleHiz() {
  if (sunucu.hasArg("arac")) aracHizi = constrain(sunucu.arg("arac").toInt(), 0, 255);
  if (sunucu.hasArg("kol"))  kolHizi  = constrain(sunucu.arg("kol").toInt(),  0, 255);
  Serial.printf("[Hiz] arac=%d kol=%d\n", aracHizi, kolHizi);
  sunucu.send(200, "text/plain", "ok");
}

// ============= SETUP =============
void setup() {
  Serial.begin(115200);
  delay(200);
  Serial.println("\n=== Robot Kontrol Başlıyor ===");

  // Röle pinleri — başlangıçta araç dururken duruş rölesi aktif
  pinMode(ROLE_KALKIS, OUTPUT);
  pinMode(ROLE_DURUS,  OUTPUT);
  digitalWrite(ROLE_KALKIS, ROLE_PASIF);
  digitalWrite(ROLE_DURUS,  ROLE_AKTIF);

  // PWM kanalları
  ledcAttach(SOL_RPWM, PWM_FREK, PWM_COZUNURLUK);
  ledcAttach(SOL_LPWM, PWM_FREK, PWM_COZUNURLUK);
  ledcAttach(SAG_RPWM, PWM_FREK, PWM_COZUNURLUK);
  ledcAttach(SAG_LPWM, PWM_FREK, PWM_COZUNURLUK);
  ledcAttach(ALT_RPWM, PWM_FREK, PWM_COZUNURLUK);
  ledcAttach(ALT_LPWM, PWM_FREK, PWM_COZUNURLUK);
  ledcAttach(UST_RPWM, PWM_FREK, PWM_COZUNURLUK);
  ledcAttach(UST_LPWM, PWM_FREK, PWM_COZUNURLUK);

  // Hepsini sıfırla
  solGrupDur(); sagGrupDur(); altEksenDur(); ustEksenDur();

  // AP başlat
  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASS);
  delay(100);
  Serial.print("AP IP adresi: ");
  Serial.println(WiFi.softAPIP());
  Serial.printf("SSID: %s  Şifre: %s\n", AP_SSID, AP_PASS);

  // Endpoint'ler
  sunucu.on("/", handleRoot);
  sunucu.on("/komut", handleKomut);
  sunucu.on("/hiz", handleHiz);
  sunucu.onNotFound([](){ sunucu.send(404, "text/plain", "yok"); });
  sunucu.begin();
  Serial.println("Web sunucu başladı.\n");
}

// ============= LOOP =============
void loop() {
  sunucu.handleClient();
}
