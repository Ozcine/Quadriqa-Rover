/*
 * ESP32-S3 Robot Kontrol
 * --------------------------------------------------------
 * Donanım:
 *   - ESP32-S3 Dev Board
 *   - 4× BTS7960 (sol 2 motor + sağ 2 motor, tank steering)
 *   - 2× BTS7960 (robot kol: alt eksen + üst eksen)
 *   - 2 kanallı röle modülü
 *   - Tüm BTS7960 EN pinleri direkt 5V'a bağlı
 *
 * Kontrol: WiFi AP + telefonda tarayıcı üzerinden buton kontrolü
 * Latch davranışı:
 *   - Röle 1 (kalkış): araç hareketteyken aktif
 *   - Röle 2 (duruş):  araç dururken aktif
 *
 * Arduino-ESP32 core 3.x üzerinde derlenir (yeni ledcAttach API).
 */

#include <WiFi.h>
#include <WebServer.h>

// ============= AP AYARLARI =============
const char* AP_SSID = "Robot-Kontrol";
const char* AP_PASS = "12345678";   // en az 8 karakter olmalı

// ============= PİN TANIMLARI =============
// Sol grup (2 motor, BTS7960'ların PWM girişleri paralel)
const int SOL_RPWM = 4;
const int SOL_LPWM = 5;
// Sağ grup (2 motor, paralel)
const int SAG_RPWM = 6;
const int SAG_LPWM = 7;
// Robot kol - alt eksen
const int ALT_RPWM = 15;
const int ALT_LPWM = 16;
// Robot kol - üst eksen
const int UST_RPWM = 17;
const int UST_LPWM = 18;
// Röleler
const int ROLE_KALKIS = 10;   // Hareket varsa aktif
const int ROLE_DURUS  = 11;   // Hareket yoksa aktif

// Röle aktif seviyesi (active-LOW modüller için LOW, active-HIGH için HIGH)
const int ROLE_AKTIF = LOW;
const int ROLE_PASIF = HIGH;

// ============= PWM AYARLARI =============
const int PWM_FREK = 5000;       // 5 kHz, sessiz ve BTS7960 için güvenli
const int PWM_COZUNURLUK = 8;    // 8-bit -> 0..255

// ============= ÇALIŞMA DURUMU =============
int aracHizi = 200;     // 0..255
int kolHizi  = 180;
bool aracHareketli = false;

WebServer sunucu(80);

// ============= RÖLE / DURUM =============
void hareketDurumGuncelle(bool hareket) {
  aracHareketli = hareket;
  digitalWrite(ROLE_KALKIS, hareket ? ROLE_AKTIF : ROLE_PASIF);
  digitalWrite(ROLE_DURUS,  hareket ? ROLE_PASIF : ROLE_AKTIF);
  Serial.print("[Durum] Araç: ");
  Serial.println(hareket ? "HAREKET" : "DURDU");
}

// ============= MOTOR KONTROL =============
void solGrupIleri(int hiz) { ledcWrite(SOL_RPWM, hiz); ledcWrite(SOL_LPWM, 0); }
void solGrupGeri (int hiz) { ledcWrite(SOL_RPWM, 0);   ledcWrite(SOL_LPWM, hiz); }
void solGrupDur ()         { ledcWrite(SOL_RPWM, 0);   ledcWrite(SOL_LPWM, 0); }

void sagGrupIleri(int hiz) { ledcWrite(SAG_RPWM, hiz); ledcWrite(SAG_LPWM, 0); }
void sagGrupGeri (int hiz) { ledcWrite(SAG_RPWM, 0);   ledcWrite(SAG_LPWM, hiz); }
void sagGrupDur ()         { ledcWrite(SAG_RPWM, 0);   ledcWrite(SAG_LPWM, 0); }

void altEksenYukari(int hiz) { ledcWrite(ALT_RPWM, hiz); ledcWrite(ALT_LPWM, 0); }
void altEksenAsagi (int hiz) { ledcWrite(ALT_RPWM, 0);   ledcWrite(ALT_LPWM, hiz); }
void altEksenDur ()          { ledcWrite(ALT_RPWM, 0);   ledcWrite(ALT_LPWM, 0); }

void ustEksenYukari(int hiz) { ledcWrite(UST_RPWM, hiz); ledcWrite(UST_LPWM, 0); }
void ustEksenAsagi (int hiz) { ledcWrite(UST_RPWM, 0);   ledcWrite(UST_LPWM, hiz); }
void ustEksenDur ()          { ledcWrite(UST_RPWM, 0);   ledcWrite(UST_LPWM, 0); }

// ============= ÜST SEVİYE ARAÇ KOMUTLARI =============
void aracIleri() { solGrupIleri(aracHizi); sagGrupIleri(aracHizi); hareketDurumGuncelle(true); }
void aracGeri () { solGrupGeri (aracHizi); sagGrupGeri (aracHizi); hareketDurumGuncelle(true); }
void aracSol  () { solGrupGeri (aracHizi); sagGrupIleri(aracHizi); hareketDurumGuncelle(true); }  // yerinde dönüş
void aracSag  () { solGrupIleri(aracHizi); sagGrupGeri (aracHizi); hareketDurumGuncelle(true); }
void aracDur  () { solGrupDur(); sagGrupDur(); hareketDurumGuncelle(false); }

// ============= WEB SAYFASI =============
